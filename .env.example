# Copy to .env and fill in real values. Never commit .env.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# JWT — use a dedicated secret, separate from Django's SECRET_KEY
JWT_SECRET_KEY=

# PostgreSQL (create the database in the server before migrate, e.g.
#   psql -U postgres -d postgres -c "CREATE DATABASE neurostock;")
POSTGRES_DB=neurostock
POSTGRES_USER=neurostock
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS — comma-separated allowed frontend origins (production)
CORS_ALLOWED_ORIGINS=http://localhost:3000
